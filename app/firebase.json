{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "server.js",
      "package.json",
      "tests/**",
      "SETUP_FIREBASE.md",
      "IMPLEMENTATION_REPORT.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)"
  }
}
